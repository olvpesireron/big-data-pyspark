    "from pyspark.sql import SparkSession\n",
    "\n",
    "# Menyiapkan Spark supaya bisa digunakan\n",
    "spark = (\n",
    "    SparkSession.builder\n",
    "    .master(\"local[2]\")\n",
    "    .appName(\"TesBayarYuk\")\n",
    "    .getOrCreate()\n",
    ")\n",
    "\n",
    "# Mengecek apakah Spark sudah berhasil dijalankan\n",
    "print(\"SPARK BERHASIL:\", spark.version)"
