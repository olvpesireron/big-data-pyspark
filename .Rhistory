reticulate::repl_python()
# setup-spark
import os
from datetime import datetime, timedelta
import pandas as pd
import numpy as np
import mongomock
from pyspark.sql import SparkSession
spark = (
SparkSession.builder.master("local[*]")
.appName("UTS_BayarYuk")
.config("spark.sql.shuffle.partitions", "8")
.getOrCreate()
)
sc = spark.sparkContext
print("Spark berhasil dijalankan:", spark.version)
# uts-data
import os
import json
import random
import shutil
from datetime import datetime, timedelta
# Gunakan seed tetap agar data yang dibuat selalu sama.
SEED = 3331
random.seed(SEED)
data_root = os.path.abspath('data_bayaryuk')
if os.path.exists(data_root):
shutil.rmtree(data_root)
os.makedirs(data_root, exist_ok=True)
jalur_log = os.path.join(data_root, 'jalur_log.txt')
landing_dir = os.path.join(data_root, 'landing')
output_parquet = os.path.join(data_root, 'parquet_valid')
checkpoint_dir = os.path.join(data_root, 'checkpoint')
os.makedirs(landing_dir, exist_ok=True)
# Merchant MongoDB tiruan: 200 dokumen.
kategori_list = ['Kuliner', 'Fashion', 'Elektronik', 'Transportasi', 'Kesehatan']
kota_list = ['Bandung', 'Jakarta', 'Surabaya', 'Yogyakarta', 'Medan']
promo_list = ['cashback', 'diskon', 'gratis_ongkir']
merchant_rows = []
for nomor in range(1, 201):
merchant = {
'_id': f'M{nomor:03d}',
'nama': f'Merchant {nomor:03d}',
'kategori': kategori_list[(nomor - 1) % len(kategori_list)],
'kota': kota_list[(nomor - 1) % len(kota_list)],
'rating': round(random.uniform(3.0, 5.0), 1),
'promo': random.sample(promo_list, k=random.randint(0, 2))
}
if nomor % 10 <= 2:
merchant['jam_buka'] = f'{random.randint(7, 10):02d}:00'
merchant_rows.append(merchant)
mongo_client = mongomock.MongoClient()
db = mongo_client['bayaryuk']
merchant_collection = db['merchant']
merchant_collection.insert_many(merchant_rows)
# Log transaksi: 400.000 baris, dengan satu baris rusak setiap 5.000 baris.
awal_waktu = datetime(2026, 10, 1, 0, 0, 0)
status_list = ['SUKSES', 'GAGAL', 'PENDING']
with open(jalur_log, 'w', encoding='utf-8') as log_file:
for nomor in range(1, 400001):
if nomor % 5000 == 0:
log_file.write('BARIS_RUSAK\n')
continue
waktu = awal_waktu + timedelta(seconds=nomor * 11)
merchant_id = f'M{random.randint(1, 200):03d}'
nominal = random.randint(1_000, 2_000_000)
if nomor % 997 == 0:
nominal = -random.randint(1_000, 100_000)
elif nomor % 1231 == 0:
nominal = 250_000_000
status = random.choices(status_list, weights=[78, 12, 10], k=1)[0]
log_file.write(
f'{waktu:%Y-%m-%d %H:%M:%S}|TRX{nomor:07d}|U{random.randint(1, 50000):05d}|'
f'{merchant_id}|{nominal}|{status}\n'
)
# Landing zone: tiga file JSON, masing-masing 500 event.
for nomor_file in range(1, 4):
file_landing = os.path.join(landing_dir, f'events_{nomor_file}.json')
with open(file_landing, 'w', encoding='utf-8') as landing_file:
for nomor_event in range(1, 501):
event = {
'id_trx': f'STR{nomor_file}{nomor_event:04d}',
'id_merchant': f'M{random.randint(1, 200):03d}',
'nominal': None if random.random() < 0.03 else random.randint(1_000, 2_000_000),
'waktu': (awal_waktu + timedelta(minutes=nomor_event)).strftime('%Y-%m-%d %H:%M:%S')
}
landing_file.write(json.dumps(event) + '\n')
print('Dataset BayarYuk siap dibuat di:', data_root)
print('Log transaksi:', jalur_log)
print('Landing zone:', landing_dir)
