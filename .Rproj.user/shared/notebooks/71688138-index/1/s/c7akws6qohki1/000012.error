nue\\n        waktu = awal_waktu + timedelta(seconds=nomor * 11)\\n        merchant_id = f'M{random.randint(1, 200):03d}'\\n        nominal = random.randint(1_000, 2_000_000)\\n        if nomor % 997 == 0:\\n            nominal = -random.randint(1_000, 100_000)\\n        elif nomor % 1231 == 0:\\n            nominal = 250_000_000\\n        status = random.choices(status_list, weights=[78, 12, 10], k=1)[0]\\n        log_file.write(\\n            f'{waktu:%Y-%m-%d %H:%M:%S}|TRX{nomor:07d}|U{random.randint(1, 50000):05d}|'\\n            f'{merchant_id}|{nominal}|{status}\\\\n'\\n        )\\n\\n# Landing zone: tiga file JSON, masing-masing 500 event.\\nfor nomor_file in range(1, 4):\\n    file_landing = os.path.join(landing_dir, f'events_{nomor_file}.json')\\n    with open(file_landing, 'w', encoding='utf-8') as landing_file:\\n        for nomor_event in range(1, 501):\\n            event = {\\n                'id_trx': f'STR{nomor_file}{nomor_event:04d}',\\n                'id_merchant': f'M{random.randint(1, 200):03d}',\\n                'nominal': None if random.random() < 0.03 else random.randint(1_000, 2_000_000),\\n                'waktu': (awal_waktu + timedelta(minutes=nomor_event)).strftime('%Y-%m-%d %H:%M:%S')\\n            }\\n            landing_file.write(json.dumps(event) + '\\\\n')\\n\\nprint('Dataset BayarYuk siap dibuat di:', data_root)\\nprint('Log transaksi:', jalur_log)\\nprint('Landing zone:', landing_dir)\\n\") : \n  could not find function \"py_run_string\"\n"}